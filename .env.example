# Copy to .env and fill every placeholder locally; never commit .env.
NEXORUTA_POSTGRES_PASSWORD=replace-with-local-postgres-password
NEXORUTA_POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=nexoruta;Username=nexoruta;Password=replace-with-local-postgres-password
NEXORUTA_API_DB_PASSWORD=replace-with-a-random-64-hex-character-secret
NEXORUTA_WORKER_DB_PASSWORD=replace-with-a-different-random-64-hex-character-secret
NEXORUTA_BOOTSTRAP_DB_PASSWORD=replace-with-a-different-random-64-hex-character-secret

NEXORUTA_ADMIN_MAIL=
NEXORUTA_ADMIN_PASSWORD=
NEXORUTA_COMERCIO_MAIL=
NEXORUTA_COMERCIO_PASSWORD=
NEXORUTA_OPERADOR_MAIL=
NEXORUTA_OPERADOR_PASSWORD=
NEXORUTA_JWT_KEY_BASE64=
NEXORUTA_SEGUIMIENTO_ENCRYPTION_KEY=
NEXORUTA_RABBITMQ_USERNAME=
NEXORUTA_RABBITMQ_PASSWORD=
Mapbox__PublicAccessToken=""