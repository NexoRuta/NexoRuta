{
  "uid": "nexoruta-demo",
  "title": "NexoRuta · infraestructura y aplicación",
  "description": "Operación de la demo de dos nodos: sesión, salud, recursos y procesos. Datos de Cloud Monitoring; sin datos no equivale a estado saludable.",
  "tags": [
    "nexoruta",
    "demo"
  ],
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-4h",
    "to": "now"
  },
  "timezone": "America/Montevideo",
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Proyecto",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "stackdriver",
          "uid": "gcp"
        },
        "definition": "Google Cloud Monitoring - Projects",
        "query": {
          "labelKey": "",
          "loading": false,
          "projectName": "$project",
          "projects": [],
          "selectedMetricType": "actions.googleapis.com/smarthome_action/num_active_users",
          "selectedQueryType": "projects",
          "selectedSLOService": "",
          "selectedService": "actions.googleapis.com",
          "sloServices": []
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "node",
        "label": "Nodo",
        "type": "custom",
        "query": "a,b",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "Todos"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "Todos",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "a",
            "value": "a"
          },
          {
            "selected": false,
            "text": "b",
            "value": "b"
          }
        ]
      },
      {
        "name": "service",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "stackdriver",
          "uid": "gcp"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": {
          "refId": "ServiceVariable",
          "selectedQueryType": "labelValues",
          "selectedMetricType": "custom.googleapis.com/nexoruta/service_up",
          "labelKey": "metric.label.service",
          "projectName": "$project"
        },
        "current": {
          "selected": true,
          "text": [
            "Todos"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Sesión y disponibilidad",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Los filtros **Nodo** y **Servicio** afectan los datos de aplicación. CPU, RAM, discos y SQL muestran todos los recursos de la demo. **Sin datos** indica que falta telemetría; no acredita disponibilidad. La última muestra permite distinguir una sesión detenida de una caída. Actualización cada minuto; Google Cloud puede demorar varios minutos en publicar datos."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Última muestra por nodo",
      "description": "Hora de la última muestra de disponibilidad recibida. Si deja de avanzar, los estados anteriores pueden estar desactualizados.",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp"
          },
          "queryType": "timeSeriesList",
          "aliasBy": "Nodo {{metric.label.node}}",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "custom.googleapis.com/nexoruta/service_up",
              "AND",
              "metric.label.node",
              "=~",
              "$node"
            ],
            "groupBys": [
              "metric.label.node"
            ],
            "alignmentPeriod": "+60s",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_MAX",
            "view": "FULL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "Time"
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "reduceFields",
            "includeTimeField": true,
            "fields": {
              "id": "byName",
              "options": "Time"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tiempo restante de sesión",
      "description": "Vencimiento común; el contador no debe ampliarse al actualizar o recuperar un nodo.",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp"
          },
          "queryType": "timeSeriesList",
          "aliasBy": "Nodo {{metric.label.node}}",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "custom.googleapis.com/nexoruta/session_remaining",
              "AND",
              "metric.label.node",
              "=~",
              "$node"
            ],
            "groupBys": [
              "metric.label.node"
            ],
            "alignmentPeriod": "+60s",
            "perSeriesAligner": "ALIGN_MIN",
            "crossSeriesReducer": "REDUCE_MAX",
            "view": "FULL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disponibilidad de servicios",
      "description": "0: la comprobación falló. 1: respondió. Un servicio HTTP disponible no acredita procesamiento de eventos.",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp"
          },
          "queryType": "timeSeriesList",
          "aliasBy": "{{metric.label.node}} · {{metric.label.service}}",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "custom.googleapis.com/nexoruta/service_up",
              "AND",
              "metric.label.node",
              "=~",
              "$node",
              "AND",
              "metric.label.service",
              "=~",
              "$service"
            ],
            "groupBys": [
              "metric.label.node",
              "metric.label.service"
            ],
            "alignmentPeriod": "+60s",
            "perSeriesAligner": "ALIGN_MIN",
            "crossSeriesReducer": "REDUCE_MIN",
            "view": "FULL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No disponible",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
